layout {
  default_tab_template {
    pane size=2 borderless=true {
      plugin location="zellij:tab-bar"
    }

    children

    pane size=2 borderless=true {
      plugin location="zellij:status-bar"
    }
  }

  tab name="cashflow" focus=true cwd="~/projects/devaspros-projects/cashflow" {
    pane split_direction="vertical" {
      pane
      pane
    }
  }

  tab name="coshinotes (2)" cwd="~/projects/devaspros-projects/coshinotes" {
    pane split_direction="vertical" {
      pane
      pane
    }
  }

  tab name="franciscoquintero" cwd="~/projects/franciscoquintero" {
    pane split_direction="vertical" {
      pane
      pane
    }
  }

  tab name="laboratorio (4)" cwd="~/projects/laboratorio_de_ruby" {
    pane split_direction="vertical" {
      pane
      pane
    }
  }
}
