layout {
  default_tab_template {
    pane size=2 borderless=true {
      plugin location="zellij:tab-bar"
    }

    children

    pane size=2 borderless=true {
      plugin location="zellij:status-bar"
    }
  }

  tab name="enlacito" cwd="~/projects/devaspros-projects/enlacito" {
    pane split_direction="vertical" {
      pane
      pane
    }
  }

  tab name="postlane (2)" cwd="~/projects/devaspros-projects/postlane-backend" {
    pane split_direction="vertical" {
      pane
      pane
    }
  }

  tab name="supermenu" cwd="~/projects/devaspros-projects/supermenu" {
    pane split_direction="vertical" {
      pane
      pane
    }
  }

  tab name="website (4)" cwd="~/projects/devaspros-projects/website" {
    pane split_direction="vertical" {
      pane
      pane
    }
  }

  tab name="prototipos" cwd="~/projects/devaspros-projects/prototipos" {
    pane split_direction="vertical" {
      pane
      pane
    }
  }
}
